#!/bin/bash
# Pre-commit hook: blocks commit if checks fail

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "Running pre-commit checks..."

# Format
echo "Checking formatting..."
if ! uv run ruff format --check . >/dev/null 2>&1; then
    echo "❌ Code is not formatted. Run 'uv run ruff format .' first."
    exit 1
fi

# Lint
echo "Running linter..."
LINT_OUTPUT=$(uv run ruff check . 2>&1)
if [ $? -ne 0 ]; then
    echo "❌ Linting failed:"
    echo "$LINT_OUTPUT"
    exit 1
fi

# Type check
echo "Running type checker..."
TYPE_OUTPUT=$(uv run pyright . 2>&1)
if [ $? -ne 0 ]; then
    echo "❌ Type check failed:"
    echo "$TYPE_OUTPUT"
    exit 1
fi

# Tests
echo "Running tests..."
TEST_OUTPUT=$(uv run pytest 2>&1)
TEST_EXIT=$?
# Exit code 5 = no tests collected (acceptable)
if [ $TEST_EXIT -ne 0 ] && [ $TEST_EXIT -ne 5 ]; then
    echo "❌ Tests failed:"
    echo "$TEST_OUTPUT"
    exit 1
fi

echo "✅ All checks passed"
exit 0
